{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Dartastic AI",
  "id": "dartastic-ai-panel",
  "info": {
    "description": "Chat with the Dartastic AI gateway from inside Grafana, admins only. Grafana's plugin proxy refuses non-admins, then forwards to the gateway at jsonData.gatewayUrl with the bearer token from secureJsonData.gatewayToken and the user's signed ID token. Refuses to render any answer without grounded citations.",
    "author": {
      "name": "Mindful Software LLC (Dartastic.io)",
      "url": "https://dartastic.io"
    },
    "keywords": [
      "dartastic",
      "ai",
      "telemetry",
      "ot",
      "chat"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Dartastic AI",
        "url": "https://dartastic.io/ai"
      },
      {
        "name": "Source",
        "url": "https://github.com/Dartastic/hosted/tree/main/grafana-plugins/dartastic-ai-panel"
      }
    ],
    "screenshots": [],
    "version": "0.3.0",
    "updated": "2026-09-25"
  },
  "includes": [
    {
      "type": "panel",
      "name": "Dartastic AI",
      "role": "Admin"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.0.0",
    "plugins": []
  },
  "routes": [
    {
      "path": "ai/api/v1/query",
      "method": "POST",
      "reqRole": "Admin",
      "url": "{{ .JsonData.gatewayUrl }}/api/v1/query",
      "headers": [
        {
          "name": "X-Forwarded-By",
          "content": "dartastic-ai-panel"
        },
        {
          "name": "Authorization",
          "content": "Bearer {{ .SecureJsonData.gatewayToken }}"
        }
      ]
    }
  ]
}
